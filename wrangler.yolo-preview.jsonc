{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "i-see-you-yolo-preview",
  "account_id": "e72be7d2513d32ec4fd7b10faecb596d",
  "main": "cloudflare/yolo-preview-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build:cloudflare"
  },
  "services": [
    {
      "binding": "CORE_API",
      "service": "i-see-you-spatial-memory"
    }
  ]
}
