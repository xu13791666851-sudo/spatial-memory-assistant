{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "i-see-you-spatial-memory",
  "account_id": "e72be7d2513d32ec4fd7b10faecb596d",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "build": {"command": "npm run build:cloudflare"},
  "ratelimits": [
    {"name": "ACCESS_LIMITER", "namespace_id": "197270101", "simple": {"limit": 10, "period": 60}},
    {"name": "VOICE_LIMITER", "namespace_id": "197270102", "simple": {"limit": 12, "period": 60}},
    {"name": "VISION_LIMITER", "namespace_id": "197270103", "simple": {"limit": 10, "period": 60}}
  ]
}
