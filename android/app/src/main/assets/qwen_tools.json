[
  {
    "type": "function",
    "function": {
      "name": "interpret_user_request",
      "description": "仅用于应用带request_id的意图请求。区分记忆、查询已存记录、找当前物品、描述当前场景、取消；查询记住了吗不能当成新的保存。",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "原样返回应用请求中的 request_id，不得自行生成。"
          },
          "intent": {
            "type": "string",
            "enum": [
              "remember",
              "recall_location",
              "memory_status",
              "recall_appearance",
              "find_now",
              "describe_scene",
              "record_location",
              "cancel",
              "complete",
              "unknown"
            ]
          },
          "target": {
            "type": "string",
            "description": "只填物品名，去除你知道、那我的等口头前缀；代词配合use_current。"
          },
          "use_current": {
            "type": "boolean",
            "description": "它、那个等指代当前选定物品时为true。"
          },
          "new_identity": {
            "type": "boolean",
            "description": "用户明确要求另记一件时为true。"
          },
          "literal_location": {
            "type": "string",
            "description": "仅在用户明确要求记下其亲口说出的地点时原文摘取；不得从画面猜填。"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "request_id",
          "intent",
          "target",
          "use_current",
          "new_identity",
          "literal_location",
          "confidence"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "describe_scene_observation",
      "description": "仅用于应用带request_id和frame_id的固定画面分析。返回观察，不执行记忆，不宣称保存成功。",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "原样返回应用请求的request_id。"
          },
          "frame_id": {
            "type": "integer",
            "description": "原样返回请求的frame_id。"
          },
          "target_visible": {
            "type": "boolean",
            "description": "指定目标在本次固定画面是否明确可见。"
          },
          "description": {
            "type": "string",
            "description": "只描述指定物品可见的外观，不说保存、记住或数据库结果；无目标时留空。"
          },
          "location": {
            "type": "string",
            "description": "仅描述同一画面可见的相对地点与参照，例如黄色桌面上、旁边有水瓶。不猜房间；不清楚留空。"
          },
          "anchor": {
            "type": "string",
            "description": "同一画面可见的稳定参照，不清楚留空。"
          },
          "items": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "可见物品名称"
                },
                "description": {
                  "type": "string",
                  "description": "可见特征，不含任何动作或记忆声明"
                },
                "location": {
                  "type": "string",
                  "description": "画面内相对位置"
                }
              },
              "required": [
                "name",
                "description",
                "location"
              ]
            }
          }
        },
        "required": [
          "request_id",
          "frame_id",
          "target_visible",
          "description",
          "location",
          "anchor",
          "items"
        ]
      }
    }
  }
]